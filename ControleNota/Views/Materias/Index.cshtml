@model IEnumerable<ControleNota.Models.Materia>

@{
    ViewData["Title"] = "Index";
}

<h1>Matérias</h1>

<p>
    <a asp-action="Create" class="btn btn-danger">Criar Novo</a>
</p>
<table class="table table-hover table-dark">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CargaHoraria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Professor)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CargaHoraria)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Professor.Nome)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.MateriaId" class="btn btn-danger">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.MateriaId" class="btn btn-danger">Detalhes</a> |
                    <a asp-action="Delete" asp-route-id="@item.MateriaId" class="btn btn-danger">Deletar</a>
            </td>
        </tr>
}
    </tbody>
</table>
