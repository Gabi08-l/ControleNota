@model ControleNota.Models.Nota

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Nota</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Valor" class="control-label"></label>
                <input asp-for="Valor" class="form-control" />
                <span asp-validation-for="Valor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataLancamento" class="control-label">Data de Lançamento </label>
                <input asp-for="DataLancamento" class="form-control" />
                <span asp-validation-for="DataLancamento" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Nome do Aluno</label>
                <input type="text" name="AlunoNome" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="MateriaId" class="control-label">Matéria</label>
                <select asp-for="MateriaId" class ="form-control mb-1" asp-items="ViewBag.MateriaId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Criar" class="btn btn-danger mb-1" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-danger">Voltar para a Lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
